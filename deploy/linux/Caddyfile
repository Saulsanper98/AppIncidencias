# Reverse proxy HTTPS para CCMGC Ticketing (LAN interna).
# Ajusta el dominio o usa :443 con IP.
#
# Instalar: sudo bash scripts/linux/setup-caddy.sh

{
	email ops@movilidadgc.org
}

:443 {
	tls internal

	encode gzip

	reverse_proxy 127.0.0.1:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

:80 {
	redir https://{host}{uri} permanent
}
