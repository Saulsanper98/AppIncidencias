# Variables de entorno para node-prod (Docker / Portainer).
# Copia a: /opt/app-incidencias/prod/data/.env
# Ajusta tras migrar desde Windows.

HOST=0.0.0.0
PORT=8080
NODE_ENV=production
TZ=Atlantic/Canary

# SQLite — el volumen monta /opt/app-incidencias/prod/data/prisma → /app/prisma
DATABASE_URL="file:./dev.db"

# URL pública (actualiza el puerto si cambias el cutover a :3000)
NEXT_PUBLIC_APP_URL="http://192.168.12.67:8080"
DATAWALL_FRAME_ANCESTOR_ORIGINS="http://192.168.12.67:8080,http://192.168.12.67:5174"

SESSION_SECRET="CAMBIA-ESTE-SECRET-32-CHARS-MINIMO"
SESSION_COOKIE_SECURE=0

RATE_LIMIT_TRUST_LAN=1

# Power BI — ver docs/power-bi-dax.md
# POWER_BI_API_KEY=""

# HTTPS opcional (montar certs/ como volumen)
# HTTPS_PORT=8443
# NEXT_PUBLIC_HTTPS_PORT=8443
# TLS_PFX_PATH=certs/server.pfx
# TLS_PFX_PASSPHRASE=""
