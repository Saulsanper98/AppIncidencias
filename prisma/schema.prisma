// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AssetType {
  validadora
  sae
  router
  pantalla
}

enum TicketStatus {
  borrador
  abierto
  en_proceso
  esperando_repuesto
  resuelto
}

enum TicketPriority {
  alta
  media
  baja
}

enum TicketDeletionRequestStatus {
  pendiente
  aprobada
  rechazada
}

enum WarehouseType {
  almacen_central
  cochera
}

enum ReservationStatus {
  reservado
  consumido
  cancelado
}

enum UserRole {
  conductor
  tecnico_campo
  gestor_centro_control
}

enum PreventiveTaskStatus {
  pendiente
  programada
  completada
  cancelada
}

enum KbArticleStatus {
  borrador
  publicado
  archivado
}

/// Estado de publicacion de un Announcement (novedad / aviso en vivo).
/// Mismos tres estados que KbArticle por consistencia mental del operador.
enum AnnouncementStatus {
  borrador
  publicado
  archivado
}

/// Tipo de Announcement.
/// novedad = entrada del changelog publico ("lo nuevo en la app", persistente).
/// aviso   = mensaje operativo en vivo (p. ej. "Reinicio en 5 min").
enum AnnouncementKind {
  novedad
  aviso
}

/// Severidad visual de un Announcement. critical = banner sticky en TODO el
/// sitio hasta que el usuario lo descarta; warning = badge destacado en
/// /novedades; info = entrada normal.
enum AnnouncementSeverity {
  info
  warning
  critical
}

/// Sentido afectado de un desvio (segun nomenclatura del PDF "Circular Informativa").
enum Sentido {
  IDA
  VUELTA
  AMBOS
}

/// Estado operativo de un desvio.
/// PENDIENTE: recien creado por el poller, esperando revision del operador.
/// ACTIVO: confirmado por un operador, ya en marcha.
/// RESUELTO: terminado correctamente.
/// CANCELADO: descartado por el operador (falsa alarma o duplicado).
enum EstadoDesvio {
  PENDIENTE
  ACTIVO
  RESUELTO
  CANCELADO
}

/// Origen del registro de desvio.
/// EMAIL: creado automaticamente por el poller a partir de la Circular Informativa.
/// MANUAL: creado a mano por un operador desde el formulario web.
enum OrigenDesvio {
  EMAIL
  MANUAL
}

model Bus {
  id          String     @id
  operator    String
  municipio   String
  lineas      String
  description String?
  assets      Asset[]
  tickets     Ticket[]
  preventiveTasks PreventiveTask[]
  photos      BusPhoto[]
}

/// Fotos del detalle de bus (galería). Las URLs apuntan a `/api/bus-media/...`.
model BusPhoto {
  id        String   @id @default(cuid())
  busId     String
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([busId])
}

/// Catalogo de lineas/servicios validos (alimenta el autocomplete de `servicioLabel`
/// en el formulario de tickets). No tiene relacion rigida con Bus: un bus puede
/// cubrir cualquier linea segun turno.
model Linea {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Configuracion generica clave/valor de la app. Cada feature que necesita
/// un parametro editable desde el panel de admin lo guarda aqui usando un
/// prefijo coherente en `key` (p. ej. "anomalous.window_days",
/// "anomalous.type_weights"). Evita proliferar tablas de 1 sola fila.
///
/// `value` siempre se almacena como string; cada lector decide como
/// interpretar (numero, JSON, bool serializado como "true"/"false"...).
model AppSetting {
  key           String   @id
  value         String
  updatedByName String?
  updatedAt     DateTime @default(now()) @updatedAt
}

/// Configuracion editable del SLA por prioridad de ticket. Una fila por
/// prioridad ("alta" | "media" | "baja"). Sustituye los valores hardcoded
/// 30/120/240 minutos que vivian en `src/lib/ticketing.ts`. Si una prioridad
/// no tiene fila, se cae al default historico (30/120/240).
model SlaConfig {
  /// Prioridad a la que aplica esta configuracion. Se usa como PK porque
  /// solo hay 3 valores posibles y SQLite no soporta enum como PK.
  priority      String   @id
  /// Minutos hasta el vencimiento de un ticket de esta prioridad.
  minutes       Int
  /// Quien edito esto por ultima vez (texto libre, no FK, para evitar
  /// migraciones cuando se borran usuarios).
  updatedByName String?
  updatedAt     DateTime @default(now()) @updatedAt
}

/// Categoría de la base de conocimiento (manuales, FAQs, etc.).
/// Sin jerarquía (todo plano por simplicidad MVP).
model KbCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?  // nombre de icono Lucide (opcional)
  color       String?  // hex o token CSS (opcional)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  articles    KbArticle[]
}

/// Artículo de la base de conocimiento: manual, FAQ o histórico de incidencia.
model KbArticle {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  summary         String?         // resumen para listados (1-2 líneas)
  contentMd       String          // cuerpo en Markdown
  status          KbArticleStatus @default(borrador)
  /// Lista de tags separados por coma. Búsqueda por LIKE.
  tags            String          @default("")
  /// Ids de tickets ejemplares vinculados (separados por coma).
  linkedTicketIds String          @default("")
  views           Int             @default(0)
  categoryId      String?
  authorId        String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        KbCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          User?           @relation("KbAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  dashboardShortcuts KbDashboardShortcut[]

  @@index([status, updatedAt])
  @@index([categoryId, status])
}

model Asset {
  id           String    @id
  busId        String
  type         AssetType
  serialNumber String
  /// Si está definido, sustituye el SLA por prioridad al crear tickets para este activo (minutos).
  slaMinutes   Int?
  bus          Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
}

model Ticket {
  id           String           @id @default(cuid())
  busId        String
  assetId      String
  tipo         String?
  subtipo      String?
  subsubtipo   String?
  dominio      String?
  nivelImpacto String?
  origenTecnico String?
  observaciones String?
  title        String
  description  String
  status       TicketStatus
  priority     TicketPriority
  slaDeadline  DateTime
  /// Coordenadas WGS84 opcionales para el mapa (si null, se usa municipio del bus).
  latitude     Float?
  longitude    Float?
  /// Municipio / lugar reconocido junto al pin del mapa (p. ej. geocodificación inversa).
  mapPlaceMunicipio String?
  /// Línea/ruta operativa cubierta por el bus en el momento de la incidencia
  /// (opcional). Autocompletable desde el catálogo `Linea` pero acepta texto libre.
  lineaLabel String?
  /// Etiqueta libre del servicio/turno/recorrido (opcional, texto libre puro).
  servicioLabel String?
  /// Nombre del conductor en el momento de la incidencia (opcional, texto libre).
  conductorLabel String?
  /// Técnico de campo asignado al ticket (opcional).
  assignedToUserId String?
  /// Usuario que abrió el ticket (nullable para tickets legacy / email).
  createdByUserId  String?
  /// Momento exacto de resolución (solo cuando status = resuelto).
  resolvedAt       DateTime?
  /// Hora real de la incidencia (puede diferir de createdAt en apuntes express).
  incidentOccurredAt DateTime?
  /// Apunte express sin tipología/adjuntos completos (incluye borradores y cerrados express).
  needsCompletion    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  bus          Bus              @relation(fields: [busId], references: [id], onDelete: Restrict)
  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedTo   User?            @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TicketCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  comments     TicketComment[]
  attachments  TicketAttachment[]
  reservations TicketPartReservation[]
  /// Vínculos en los que ESTE ticket es el origen (este → otro).
  relationsFrom TicketRelation[] @relation("TicketRelationFrom")
  /// Vínculos en los que ESTE ticket es el destino (otro → este).
  relationsTo   TicketRelation[] @relation("TicketRelationTo")
  watchers      TicketWatcher[]
  statusHistory TicketStatusChange[]
  desvioLinks   TicketDesvioLink[]
  deletionRequests TicketDeletionRequest[]

  @@index([createdByUserId])
  @@index([resolvedAt])
  @@index([status, updatedAt])
}

/// Relacion N:N entre tickets para "adjuntar" tickets ya resueltos (u otros)
/// a un ticket nuevo. Se guarda UNA fila por par; la UI muestra el vinculo en
/// ambas direcciones haciendo OR sobre fromTicketId/toTicketId.
model TicketRelation {
  id              String   @id @default(cuid())
  fromTicketId    String
  toTicketId      String
  /// Tipo de relacion (texto libre acotado: "relacionado" por defecto;
  /// reservado por si en el futuro distinguimos "duplicado", "causa", etc.).
  kind            String   @default("relacionado")
  note            String?
  createdAt       DateTime @default(now())
  createdByUserId String?
  fromTicket      Ticket   @relation("TicketRelationFrom", fields: [fromTicketId], references: [id], onDelete: Cascade)
  toTicket        Ticket   @relation("TicketRelationTo",   fields: [toTicketId],   references: [id], onDelete: Cascade)
  createdBy       User?    @relation("TicketRelationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([fromTicketId, toTicketId])
  @@index([toTicketId])
}

/// Solicitud de borrado de ticket por un técnico de campo; la aprueba un gestor.
model TicketDeletionRequest {
  id                String                      @id @default(cuid())
  ticketId          String
  requestedByUserId String
  reason            String
  status            TicketDeletionRequestStatus @default(pendiente)
  reviewedByUserId  String?
  reviewNote        String?
  createdAt         DateTime                    @default(now())
  reviewedAt        DateTime?

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("TicketDeletionRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?  @relation("TicketDeletionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ticketId])
  @@index([requestedByUserId])
}

/// Historial estructurado de cambios de estado (timeline visual).
model TicketStatusChange {
  id              String        @id @default(cuid())
  ticketId        String
  fromStatus      TicketStatus?
  toStatus        TicketStatus
  changedByUserId String?
  changedByName   String
  comment         String?
  createdAt       DateTime      @default(now())
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Suscripción de un usuario a un ticket para recibir notificaciones.
model TicketWatcher {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([userId])
}

/// Vínculo entre ticket técnico y desvío operativo (manual o automático).
model TicketDesvioLink {
  id              String   @id @default(cuid())
  ticketId        String
  desvioId        String
  /// "manual" | "auto"
  kind            String   @default("manual")
  createdAt       DateTime @default(now())
  createdByUserId String?
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  desvio          Desvio   @relation(fields: [desvioId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("TicketDesvioLinkCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([ticketId, desvioId])
  @@index([desvioId])
}

/// Entrada del catálogo de tipologías (editable desde admin).
model TipologiaEntry {
  id             String   @id @default(cuid())
  tipo           String
  subtipo        String
  subsubtipo     String
  dominio        String
  nivelImpacto   String
  origenTecnico  String
  observaciones  String   @default("")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tipo, subtipo, subsubtipo])
  @@index([active, sortOrder])
}

/// Reglas de escalado automático (una fila singleton).
model EscalationConfig {
  id                     String   @id @default("default")
  unassignedAltaMinutes  Int      @default(15)
  unassignedMediaMinutes Int      @default(60)
  unassignedBajaMinutes  Int      @default(240)
  slaWarnMinutes         Int      @default(15)
  staleTicketHours       Int      @default(48)
  /// Asignación automática al crear ticket (reglas + carga).
  autoAssignEnabled      Boolean  @default(true)
  /// Reasignar al técnico con menor carga cuando vence el SLA.
  slaReassignEnabled     Boolean  @default(true)
  updatedByName          String?
  updatedAt              DateTime @updatedAt
}

/// Regla de asignación automática de tickets a técnicos.
/// Se evalúan por `sortOrder` ascendente; la primera que coincida gana.
/// Campos null = comodín (cualquier operadora, línea o turno).
model TicketAssignmentRule {
  id         String   @id @default(cuid())
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  /// Operadora del bus (p. ej. TIL). Null = cualquiera.
  operator   String?
  /// Subcadena de lineaLabel (case-insensitive). Null = cualquiera.
  lineaMatch String?
  /// Turno M/T/N al momento de asignar. Null = cualquier turno.
  shift      String?
  userId     String
  user       User     @relation("TicketAssignmentRuleTechnician", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([userId])
}

/// Programación de tickets recurrentes / preventivos auto-generados.
model TicketRecurrence {
  id              String    @id @default(cuid())
  name            String
  active          Boolean   @default(true)
  intervalDays    Int
  /// JSON con campos del formulario (tipo, title, description, busId…).
  templateJson    String
  busId           String?
  nextRunAt       DateTime
  lastRunAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       User?     @relation("TicketRecurrenceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([active, nextRunAt])
}

/// Atajo destacado de KB en el dashboard (gestor elige artículos).
model KbDashboardShortcut {
  id        String    @id @default(cuid())
  articleId String
  sortOrder Int       @default(0)
  label     String?
  createdAt DateTime  @default(now())
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

/// Suscripción Web Push de un usuario (notificaciones fuera del navegador).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  author    String
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  /// Nombre del fichero en disco (carpeta uploads/tickets/{ticketId}/); null = solo metadato legacy
  diskFileName String?
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id        String           @id @default(cuid())
  name      String
  municipio String
  type      WarehouseType
  stocks    InventoryStock[]
  reservations TicketPartReservation[]
  @@unique([name, municipio])
}

model SparePart {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  name                String
  compatibleAssetType AssetType
  minimumLevel        Int                    @default(1)
  stocks              InventoryStock[]
  reservations        TicketPartReservation[]
}

model InventoryStock {
  id          String    @id @default(cuid())
  warehouseId String
  sparePartId String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, sparePartId])
}

model TicketPartReservation {
  id          String            @id @default(cuid())
  ticketId    String
  sparePartId String
  warehouseId String
  quantity    Int               @default(1)
  status      ReservationStatus @default(reservado)
  createdAt   DateTime          @default(now())
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sparePart   SparePart         @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
}

model User {
  id         String       @id @default(cuid())
  name       String
  email      String       @unique
  role       UserRole
  isActive   Boolean      @default(true)
  /// Si está activo, el usuario solo puede LEER en toda la app: el servidor
  /// rechaza cualquier petición mutante (POST/PATCH/PUT/DELETE) y el cliente
  /// renderiza solo la vista /lectura. Útil para cuentas de consulta
  /// (`read@movilidadgc.org`) usadas por personas que necesitan ver la
  /// bandeja de incidencias en una pantalla sin riesgo de tocar nada.
  isReadOnly Boolean      @default(false)
  /// Hash bcrypt de la contraseña local. Nullable: cuentas legacy sin contraseña no pueden iniciar sesión hasta que un gestor les asigne una.
  passwordHash         String?
  /// Forzar cambio de contraseña en el próximo login (alta nueva o reset por administrador).
  mustChangePassword   Boolean      @default(false)
  /// Fecha de la última modificación de la contraseña (para auditoría / rotación opcional).
  passwordUpdatedAt    DateTime?
  /// Fecha del último login exitoso.
  lastLoginAt          DateTime?
  /// URL pública o externa del avatar (admite GIF animado).
  avatarUrl            String?
  /// URL pública o externa del banner del perfil (admite GIF animado).
  bannerUrl            String?
  /// Biografía corta / firma del usuario (máx 280 caracteres en API).
  bio                  String?
  /// Puesto o departamento mostrado bajo el nombre (ej. "Sistemas").
  position             String?
  /// Teléfono de contacto opcional.
  phone                String?
  /// Si está definido, `/dashboard` redirige a este panel personalizado.
  preferredDashboardId String?
  /// Fecha en que el usuario pulsó "Limpiar" en la campana de notificaciones.
  /// Eventos anteriores a esta marca no se cuentan ni se muestran en su lista.
  notificationsClearedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  auditEvents AuditEvent[]
  uxEvents    UxEvent[]
  createdPreventiveTasks PreventiveTask[] @relation("PreventiveTaskCreator")
  assignedPreventiveTasks PreventiveTask[] @relation("PreventiveTaskAssignee")
  assignedTickets Ticket[] @relation("TicketAssignee")
  createdTickets  Ticket[] @relation("TicketCreator")
  ticketWatchers  TicketWatcher[]
  ticketDesvioLinks TicketDesvioLink[] @relation("TicketDesvioLinkCreator")
  ticketRecurrences TicketRecurrence[] @relation("TicketRecurrenceCreator")
  pushSubscriptions PushSubscription[]
  createdDashboards CustomDashboard[] @relation("DashboardCreator")
  preferredDashboard CustomDashboard? @relation("UserPreferredDashboard", fields: [preferredDashboardId], references: [id], onDelete: SetNull)
  feedbackItems UserFeedback[]
  feedbackVotes FeedbackVote[]
  kbArticles    KbArticle[]      @relation("KbAuthor")
  dailyReports  DailyReport[]    @relation("DailyReportAuthor")
  createdTicketRelations TicketRelation[] @relation("TicketRelationCreator")
  authoredAnnouncements Announcement[]  @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  ticketTemplates       TicketTemplate[] @relation("TicketTemplateOwner")
  savedTicketViews      SavedTicketView[] @relation("SavedTicketViewOwner")
  authoredHandovers     ShiftHandover[] @relation("HandoverAuthor")
  acknowledgedHandovers ShiftHandover[] @relation("HandoverAcknowledged")
  bitacoraEntries       BitacoraEntry[] @relation("BitacoraAuthor")
  ticketAssignmentRules TicketAssignmentRule[] @relation("TicketAssignmentRuleTechnician")
  ticketDeletionRequests TicketDeletionRequest[] @relation("TicketDeletionRequester")
  reviewedTicketDeletions TicketDeletionRequest[] @relation("TicketDeletionReviewer")
}

model UserFeedback {
  id          String   @id @default(cuid())
  /// "idea" | "error" | "mejora"
  type        String
  /// "interfaz" | "funcionalidad" | "rendimiento" | "documentacion" | "otro"
  category    String
  title       String
  description String
  /// Puntuación de satisfacción general 1-5
  rating      Int?
  /// "baja" | "media" | "alta"
  urgency     String   @default("media")
  /// Nombre de la sección/URL de donde envió el feedback
  currentPage String?
  appVersion  String?
  userId      String?
  /// Nombre del usuario en el momento del envío (desnormalizado)
  userName    String?
  userRole    String?
  /// "pendiente" | "en_revision" | "planificado" | "implementado" | "descartado"
  status      String   @default("pendiente")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments FeedbackAttachment[]
  votes       FeedbackVote[]

  @@index([createdAt])
  @@index([type, status])
  @@index([userId, createdAt])
}

/// Voto positivo (upvote) de un usuario sobre un reporte de feedback.
/// Se usa en /sugerencias para priorizar ideas/mejoras según interés del
/// equipo. Restricción única (feedbackId, userId): un usuario solo puede
/// votar una vez por sugerencia (toggle si vuelve a pulsar).
model FeedbackVote {
  id         String       @id @default(cuid())
  feedbackId String
  userId     String
  createdAt  DateTime     @default(now())
  feedback   UserFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([feedbackId])
}

/// Adjuntos de un reporte de feedback (capturas de pantalla principalmente).
/// Se guardan en `public/uploads/feedback/{feedbackId}/{diskFileName}`. La
/// relación es `onDelete: Cascade`: si se borra el feedback, se borran sus
/// adjuntos en BD (los ficheros físicos se limpian aparte si hace falta).
model FeedbackAttachment {
  id           String       @id @default(cuid())
  feedbackId   String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  diskFileName String
  createdAt    DateTime     @default(now())
  feedback     UserFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  ticketId   String?
  action     String
  detail     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Telemetría de uso (UX analytics).
///
/// Cada fila es UN evento del cliente. La gracia de tenerlo en BD propia (no
/// en Google Analytics) es que podemos cruzarlo con tickets/turnos/usuarios
/// reales sin depender de servicios externos ni de la red exterior.
///
/// Convenciones:
///   - `eventName` es snake_case con prefijo de dominio: `page_visit`,
///     `ticket_create_open`, `ticket_create_step`, `ticket_create_complete`,
///     `ticket_create_abandon`, `feedback_submit_open/complete/abandon`,
///     `search_query`, `client_error`, `ticket_status_change`, `ticket_resolved`, etc.
///   - `ticket_resolved` (servidor): props JSON con `ticket_id`, `from_status`,
///     `to_status`, `resolution_channel` (`status_change` | `create_closed` |
///     `express` | `draft_promote`), `sla_met`, `assigned`, etc. Ver
///     `trackTicketResolvedTelemetry` en `lib/ticket-resolution-telemetry.ts`.
///   - `sessionId` es un UUID generado en el cliente y persistido en
///     sessionStorage. Permite agrupar eventos de la misma pestaña.
///   - `path` es la ruta donde se disparó (`/tickets`, `/dashboard`...).
///   - `durationMs` opcional: solo para eventos "cerrados" que miden tiempo
///     (page_visit, ticket_create_complete, ticket_create_step...).
///   - `shift` se calcula al insertar: M (06-14), T (14-22) o N (22-06).
///     Permite filtrar/agregar por turno sin recalcular en consulta.
///   - `props` es JSON arbitrario (stringified) con campos específicos del
///     evento (template_id, n_results, step_name, error_message, etc.).
model UxEvent {
  id         String   @id @default(cuid())
  userId     String?
  /// Rol del usuario en el momento del evento. Lo guardamos congelado para
  /// poder reportar por rol aunque el usuario cambie de rol después.
  userRole   String?
  eventName  String
  sessionId  String?
  path       String?
  durationMs Int?
  /// "M" (mañana 06-14), "T" (tarde 14-22), "N" (noche 22-06).
  shift      String?
  /// "desktop" | "mobile" | "tablet" — inferido del User-Agent al insertar.
  device     String?
  /// JSON arbitrario con datos específicos del evento.
  props      String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

/// Registro de cada generación del informe diario "para Jefatura".
/// Sirve para avisar a usuarios posteriores que el informe ya se generó hoy
/// (sin bloquear la generación: cada compañero puede sacar el suyo).
model DailyReport {
  id            String   @id @default(cuid())
  /// Fecha del informe en formato YYYY-MM-DD (huso local del sistema).
  /// Se usa para buscar duplicados del mismo día con un GET por igualdad exacta.
  reportDate    String
  /// Nº de tickets que iban incluidos en la generación (para mostrar resumen).
  ticketCount   Int      @default(0)
  /// Usuario que generó el informe (nullable si después se borra ese usuario).
  generatedById String?
  generatedBy   User?    @relation("DailyReportAuthor", fields: [generatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([reportDate, createdAt])
}

model PreventiveTask {
  id              String               @id @default(cuid())
  busId           String
  assetType       AssetType
  reason          String
  status          PreventiveTaskStatus @default(pendiente)
  scheduledAt     DateTime?
  createdByUserId String?
  assignedToUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  bus             Bus                  @relation(fields: [busId], references: [id], onDelete: Cascade)
  createdByUser   User?                @relation("PreventiveTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedToUser  User?                @relation("PreventiveTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
}

model CustomDashboard {
  id              String            @id @default(cuid())
  name            String
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       User?             @relation("DashboardCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  widgets         DashboardWidget[]
  usersPreferringThis User[]        @relation("UserPreferredDashboard")
}

model DashboardWidget {
  id          String          @id @default(cuid())
  dashboardId String
  title       String
  chartType   String
  dataSource  String
  size        String          @default("medium")
  order       Int             @default(0)
  config      String          @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  dashboard   CustomDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId, order])
  @@index([dashboardId, updatedAt])
}

/// Desvio en carretera detectado a partir de la "Circular Informativa" que envia
/// jefesala@movilidadgc.org. El poller extrae los datos del PDF y crea el registro
/// con estado PENDIENTE; el operador lo revisa y lo confirma (ACTIVO), resuelve o
/// cancela. Tambien se permite la creacion MANUAL desde el formulario web.
///
/// IMPORTANTE: SQLite no soporta arrays nativos. `lineas_afectadas`, `paradas_fuera`
/// y `paradas_alternativas` se almacenan como JSON serializado (string). Los helpers
/// de `src/lib/desvios/serializers.ts` se encargan de leer/escribir esos campos.
model Desvio {
  id                   String       @id @default(cuid())
  referencia           String
  entorno              String       @default("PRODUCCION")
  titulo               String
  via                  String
  tramo                String
  fecha_inicio         DateTime
  fecha_fin            DateTime
  hora_fin_estimada    Boolean      @default(false)
  /// Desvio sin fecha de fin programada: queda vivo hasta que un operador
  /// lo marca como RESUELTO/CANCELADO. Util para cortes recurrentes o por
  /// franjas horarias que se "activan/desactivan" a mano. Cuando es true,
  /// `fecha_fin` se ignora en la UI (se almacena el valor que envia el
  /// formulario, normalmente igual a fecha_inicio).
  sin_fecha_fin        Boolean      @default(false)
  motivo               String
  sentido              Sentido
  /// JSON string con el array de lineas afectadas. Ejemplos: '["303"]' o '["19","36"]'.
  lineas_afectadas     String
  url_itinerario       String?
  /// JSON string con `[{nombre, codigo}]` de las paradas fuera de servicio.
  paradas_fuera        String       @default("[]")
  /// JSON string con `[{nombre, codigo}]` de las paradas alternativas.
  paradas_alternativas String       @default("[]")
  estado               EstadoDesvio @default(PENDIENTE)
  origen               OrigenDesvio @default(EMAIL)
  /// Identificador del correo en el proveedor (Gmail messageId / IMAP UID...). Sirve
  /// como llave de idempotencia para no volver a procesar el mismo correo.
  email_origen_id      String?
  /// Ruta relativa al binario del PDF original dentro de `public/uploads/desvios/`.
  pdf_path             String?
  notas                String?
  creado_en            DateTime     @default(now())
  actualizado_en       DateTime     @updatedAt
  confirmado_por       String?
  confirmado_en        DateTime?
  ticketLinks          TicketDesvioLink[]

  @@index([estado, fecha_inicio])
  @@index([referencia])
  @@index([email_origen_id])
}

/// Aviso/novedad publicado por un gestor para que TODOS los usuarios lo vean.
/// - `kind = aviso`: mensaje operativo en vivo (reinicios, mantenimientos,
///   incidencias). Si `severity = critical`, aparece como banner sticky en
///   todas las paginas hasta que el usuario lo descarta.
/// - `kind = novedad`: entrada del changelog publico ("lo nuevo en la app",
///   persistente). Se ve en /novedades.
///
/// El emisor publica `announcement_new/updated/deleted` en `sseBus` para que
/// los clientes conectados al stream reaccionen en tiempo real.
model Announcement {
  id           String               @id @default(cuid())
  kind         AnnouncementKind
  severity     AnnouncementSeverity @default(info)
  title        String
  /// Cuerpo en Markdown (renderizado con react-markdown + remark-gfm).
  bodyMd       String               @default("")
  status       AnnouncementStatus   @default(borrador)
  /// Si esta marcado, aparece anclado arriba en la pagina de Novedades
  /// (independiente del banner global que SIEMPRE muestra los critical).
  pinned       Boolean              @default(false)
  /// Fecha de publicacion. Se rellena al pasar de borrador a publicado.
  publishedAt  DateTime?
  /// Fecha en la que el aviso deja de mostrarse automaticamente (opcional).
  /// Util para mantenimientos programados: "valido hasta las 14:30".
  expiresAt    DateTime?
  authorId     String?
  /// Nombre del autor desnormalizado por si se borra el usuario.
  authorName   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  author       User?                @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads        AnnouncementRead[]

  @@index([kind, status, publishedAt])
  @@index([status, expiresAt])
}

/// Marca que un usuario ya ha visto / descartado un Announcement concreto.
/// Sirve para:
///  1) Ocultar el banner sticky del aviso critico tras pulsar "Entendido".
///  2) Calcular el badge de "no leidos" en el sidebar.
model AnnouncementRead {
  userId         String
  announcementId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([userId, announcementId])
  @@index([userId, readAt])
}

/// Plantilla de ticket reutilizable. Pre-rellena título, descripción, tipo,
/// subtipo, subsubtipo y prioridad al crear un ticket. `scope = personal` =>
/// solo la ve / edita el dueño; `scope = global` => visible para todos pero
/// editable solo por gestores. Campo `category` libre para agrupar en el UI.
model TicketTemplate {
  id          String          @id @default(cuid())
  name        String
  scope       String          @default("personal")
  ownerId     String?
  title       String?
  description String?
  tipo        String?
  subtipo     String?
  subsubtipo  String?
  priority    TicketPriority?
  category    String?
  /// Líneas afectadas precargadas (1..10). Cuando la plantilla representa
  /// un patrón concreto (ej. "Salto de viaje en GL-1") tiene sentido fijar
  /// este valor para que el ticket rápido nazca con la prioridad correcta.
  impactedLines  Int?
  /// Si la incidencia detiene el servicio (afecta al cálculo de prioridad).
  serviceStopped Boolean?
  /// Etiquetas libres prellenadas (línea, servicio, conductor) y comentario
  /// inicial. Útil cuando un técnico repite el mismo tipo de parte en
  /// idénticas condiciones (sugerencia de OP03 "Salto de viaje").
  lineaLabel     String?
  servicioLabel  String?
  commentInitial String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  owner       User?           @relation("TicketTemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([ownerId])
}

/// Pase de turno (handover) entre M/T/N. El turno que cierra describe lo
/// ocurrido y deja un resumen, alertas y acciones pendientes. El turno
/// entrante lo "acepta" (acknowledged) cuando ha leído el contenido. Todos
/// los campos de texto son libres; la app no impone una taxonomía.
model ShiftHandover {
  id                String   @id @default(cuid())
  /// yyyy-mm-dd del turno saliente.
  shiftDate         String
  /// "M" | "T" | "N".
  shift             String
  authorId          String?
  authorName        String?
  summary           String
  alerts            String?
  pendingActions    String?
  /// Snapshot opcional de tickets abiertos relevantes al cierre (JSON
  /// serializado). El cliente lo pinta como lista clicable; si falta,
  /// solo se muestran los campos de texto.
  openTicketsJson   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  acknowledgedById  String?
  acknowledgedByName String?
  acknowledgedAt    DateTime?
  author            User?    @relation("HandoverAuthor",        fields: [authorId],         references: [id], onDelete: SetNull)
  acknowledgedBy    User?    @relation("HandoverAcknowledged",  fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([shiftDate, shift])
  @@index([createdAt])
}

/// Tipo de entrada en la bitácora de turno (Conocimiento → Bitácora).
enum BitacoraEntryKind {
  nota
  alerta
  pendiente
}

/// Entrada de bitácora: log operativo continuo entre turnos M/T/N.
/// El contenido se guarda como JSON de TipTap (`contentJson`).
model BitacoraEntry {
  id          String            @id @default(cuid())
  /// yyyy-mm-dd del turno al que pertenece la nota.
  shiftDate   String
  /// "M" | "T" | "N".
  shift       String
  kind        BitacoraEntryKind @default(nota)
  /// Título opcional para localizar la nota en el timeline.
  title       String?
  contentJson String
  /// Las entradas fijadas se muestran arriba del timeline del turno.
  pinned      Boolean           @default(false)
  authorId    String?
  authorName  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  author      User?             @relation("BitacoraAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([shiftDate, shift, createdAt])
  @@index([pinned, createdAt])
  @@index([createdAt])
}

/// Vista guardada del listado de tickets: combina filtros (estado, prioridad,
/// operadora, "mis tickets", búsqueda, etc.) bajo un nombre. La query se
/// serializa como string querystring (`?status=abierto&priority=alta`) para
/// permitir enlaces directos y migraciones triviales si en el futuro cambian
/// los filtros disponibles.
model SavedTicketView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     String
  scope     String   @default("personal")
  createdAt DateTime @default(now())
  user      User     @relation("SavedTicketViewOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
