# Base de datos local (SQLite). Tras clonar: copia este archivo a `.env` y ejecuta `npx prisma migrate deploy`.
# Ruta relativa a `prisma/` → fichero `prisma/dev.db` en el proyecto.
DATABASE_URL="file:./dev.db"

# Opcional: URL pública de la app (enlaces en emails de notificación).
# NEXT_PUBLIC_APP_URL="https://tu-dominio.example"

# Opcional: forzar selector de usuario en login (demos / E2E). En desarrollo suele activarse sin esto; ver `src/lib/dev-auth.ts`.
# NEXT_PUBLIC_DEV_LOGIN_SELECTOR=1

# Embeber la app en iframe desde DataWall Display (Next envía CSP frame-ancestors; sin X-Frame-Options).
# Por defecto ya se permiten http://localhost:5174 y http://127.0.0.1:5174. Si el muro usa IP de red, añade el origen exacto:
# DATAWALL_FRAME_ANCESTOR_ORIGINS="http://192.168.1.50:5174"

# --- Notificaciones externas (opcional) ---
# Email vía Resend: https://resend.com
# RESEND_API_KEY=""
# NOTIFICATION_EMAIL_FROM="CCMGC <onboarding@resend.dev>"
# NOTIFICATION_EMAIL_TO="operaciones@example.com"

# SMS vía Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+34..."
# NOTIFICATION_SMS_TO="+34..."

# --- Módulo Desvíos: poller de correo ---
# El poller monitoriza el buzón del "jefe de sala" y crea desvíos automáticamente
# a partir de cada PDF "Circular Informativa". Si EMAIL_PROVIDER queda vacío, el
# módulo sigue funcionando manualmente (crear desde /desvios/nuevo).

# Proveedor: graph | gmail | imap | outlook
#   graph   → Microsoft 365 vía Microsoft Graph (recomendado para movilidadgc.org)
#   imap    → IMAP genérico (Outlook con app-password, dovecot, hMailServer…)
#   gmail   → Gmail vía OAuth (requiere registrar OAuth client en Google Cloud)
#   outlook → alias de imap, configura IMAP_* con outlook.office365.com
# EMAIL_PROVIDER=graph

# Intervalo de polling en segundos (mínimo 30, recomendado 300 = 5 minutos)
# EMAIL_POLL_INTERVAL=300

# Remitente autorizado: cualquier correo de otra cuenta es ignorado
# EMAIL_AUTHORIZED_SENDER=jefesala@movilidadgc.org

# --- Opción A (recomendada para Microsoft 365): Microsoft Graph ---
# Requiere registrar una App en Entra ID con permisos de aplicación
# Mail.Read y Mail.ReadWrite, y consentimiento de admin.
# Recomendado: restringir al buzón con New-ApplicationAccessPolicy.
# MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_GRAPH_CLIENT_SECRET=el-valor-del-secreto-de-cliente
# MS_GRAPH_MAILBOX=centrocontrol@movilidadgc.org

# --- Opción B: IMAP genérico ---
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=cuenta@dominio.org
# IMAP_PASSWORD=app-password-larga
# IMAP_TLS=true
# IMAP_MAILBOX=INBOX

# --- Opción C: Gmail OAuth ---
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=me
