# Base de datos local (SQLite). Tras clonar: copia este archivo a `.env` y ejecuta `npx prisma migrate deploy`.
# Ruta relativa a `prisma/` → fichero `prisma/dev.db` en el proyecto.
DATABASE_URL="file:./dev.db"

# Opcional: URL pública de la app (enlaces en emails de notificación).
# NEXT_PUBLIC_APP_URL="https://tu-dominio.example"

# Opcional: forzar selector de usuario en login (demos / E2E). En desarrollo suele activarse sin esto; ver `src/lib/dev-auth.ts`.
# NEXT_PUBLIC_DEV_LOGIN_SELECTOR=1

# Embeber la app en iframe desde DataWall Display (Next envía CSP frame-ancestors; sin X-Frame-Options).
# Por defecto ya se permiten http://localhost:5174 y http://127.0.0.1:5174. Si el muro usa IP de red, añade el origen exacto:
# DATAWALL_FRAME_ANCESTOR_ORIGINS="http://192.168.1.50:5174"

# --- Notificaciones externas (opcional) ---
# Email vía Resend: https://resend.com
# RESEND_API_KEY=""
# NOTIFICATION_EMAIL_FROM="CCMGC <onboarding@resend.dev>"
# NOTIFICATION_EMAIL_TO="operaciones@example.com"

# SMS vía Twilio
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+34..."
# NOTIFICATION_SMS_TO="+34..."
